generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  activePetId String?
  activePet   Pet? @relation("ActivePet", fields: [activePetId], references: [id])

  pets        Pet[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  type      String
  breed     String?
  age       Int?
  weight    Float?
  photoUrl  String?

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt      

  activeForUsers User[] @relation("ActivePet")
}