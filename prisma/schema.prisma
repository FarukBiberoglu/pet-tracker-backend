generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  activePetId String?
  activePet   Pet? @relation("ActivePet", fields: [activePetId], references: [id])

  pets        Pet[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  type      String
  breedId   String?
  breed     Breed?   @relation(fields: [breedId], references: [id])
  age       Int?
  weight    Float?
  photoUrl  String?

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt      

  activeForUsers User[] @relation("ActivePet")
  medications   Medication[]
}

model Breed {
  id String @id @default(uuid())
  name String
  type String

  pets Pet[]
}


model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  title     String?

  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String 
  content   String
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id])
}

model Medication {
  id        String   @id @default(uuid())
  name      String

  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])

  dosageAmount Float?
  dosageUnit   DosageUnit? 

  frequency String

  startDate DateTime @default(now())
  endDate   DateTime?

  notes     String?

  createdAt DateTime @default(now())

  times MedicationTime[]
}
 model MedicationTime {
  id String @id @default(uuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id])
  time          String
  createdAt     DateTime @default(now())
 }


enum DosageUnit {
  TABLET
  ML
  CAPSULE
  DROP
  INJECTION
  OTHER
}

